---
// Shell for the Resonance theme (/resonance/ routes): deep field, grain, nav,
// footer, and the resonance-ui interaction layer. Resonance pages are noindex
// and excluded from the sitemap (see astro.config.mjs); the terminal pages
// stay the canonical site.
import type { ComponentProps } from 'astro/types';
import MainHead from '../components/MainHead.astro';
import { buildRSNav, type RSNavItem } from '../components/resonance/nav';
import '../styles/resonance.css';

type Props = ComponentProps<typeof MainHead> & {
	/** Override the nav (pages pass buildRSNav with their section + exit twin). */
	navItems?: RSNavItem[] | undefined;
};

const { navItems = buildRSNav(), ...headProps } = Astro.props;
---

<html lang="en-US" class="rs-root">
	<head>
		<MainHead {...headProps} noIndex preloadFonts={false} themeColor="#050807" />
		<link rel="preload" href="/fonts/cormorant-garamond-600.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/cormorant-garamond-500-italic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/space-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="rs">
		<a class="rs-skip-link" href="#main-content">Skip to content</a>
		<div class="rs-field" aria-hidden="true"></div>
		<div class="rs-grain" aria-hidden="true"></div>

		<nav class="rs-nav" aria-label="Site">
			{navItems.map((item) => (
				<a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>

		<div class="rs-page">
			<div id="main-content" tabindex="-1">
				<slot />
			</div>
			<footer class="rs-footer">
				<p class="sig">Abushady &middot; exit 0</p>
				<p class="last">All of this was inevitable.</p>
			</footer>
		</div>

		<script>
			import { initResonance } from '../scripts/resonance-ui';
			import { yearsOfExperience } from '../utils/experience';

			initResonance();

			// Same stale-deploy refresh the other layouts do.
			document.querySelectorAll('.years-exp').forEach((el) => {
				el.textContent = yearsOfExperience() + '+';
			});
		</script>

		<style>
			#main-content {
				outline: none;
			}
		</style>
	</body>
</html>
