---
// The hero centerpiece: a conjured spell circle mounted on a machined core.
// Ward, orbiting mote, observation brackets, and the SVG assembly. Purely
// decorative; the page's text carries the meaning.
---

<div class="rs-anomaly" aria-hidden="true">
	<span class="rs-ward"></span>
	<span class="rs-mote"></span>
	<span class="rs-halo"></span>
	<span class="rs-bracket b-tl"></span>
	<span class="rs-bracket b-tr"></span>
	<span class="rs-bracket b-bl"></span>
	<span class="rs-bracket b-br"></span>
	<svg viewBox="0 0 200 200">
		<defs>
			<radialGradient id="rs-corebloom">
				<stop offset="0" stop-color="#35e57c" stop-opacity="0.65"></stop>
				<stop offset="1" stop-color="#35e57c" stop-opacity="0"></stop>
			</radialGradient>
			<filter id="rs-spellglow" x="-40%" y="-40%" width="180%" height="180%">
				<feGaussianBlur stdDeviation="2.2" result="b"></feGaussianBlur>
				<feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
			</filter>
		</defs>

		<!-- what remains of the machine: mount ring and four bolts -->
		<g fill="none" stroke="#d3dad6">
			<circle cx="100" cy="100" r="58" stroke-width="1" opacity="0.35"></circle>
		</g>
		<g fill="#d3dad6" opacity="0.3">
			<circle cx="100" cy="8" r="2"></circle><circle cx="100" cy="192" r="2"></circle>
			<circle cx="8" cy="100" r="2"></circle><circle cx="192" cy="100" r="2"></circle>
		</g>

		<!-- the conjured circle -->
		<g class="spin" filter="url(#rs-spellglow)" fill="none" stroke="#35e57c" opacity="0.85">
			<circle cx="100" cy="100" r="90" stroke-width="1.2"></circle>
			<g stroke-width="1.2">
				<line x1="100" y1="6" x2="100" y2="16"></line><line x1="100" y1="184" x2="100" y2="194"></line>
				<line x1="6" y1="100" x2="16" y2="100"></line><line x1="184" y1="100" x2="194" y2="100"></line>
				<line x1="53" y1="18.6" x2="58" y2="27.2"></line><line x1="142" y1="172.8" x2="147" y2="181.4"></line>
				<line x1="147" y1="18.6" x2="142" y2="27.2"></line><line x1="58" y1="172.8" x2="53" y2="181.4"></line>
				<line x1="18.6" y1="53" x2="27.2" y2="58"></line><line x1="172.8" y1="142" x2="181.4" y2="147"></line>
				<line x1="181.4" y1="53" x2="172.8" y2="58"></line><line x1="27.2" y1="142" x2="18.6" y2="147"></line>
			</g>
			<rect x="96.5" y="20.5" width="7" height="7" transform="rotate(45 100 24)" stroke-width="1"></rect>
			<rect x="96.5" y="172.5" width="7" height="7" transform="rotate(45 100 176)" stroke-width="1"></rect>
			<circle cx="24" cy="100" r="3.4" stroke-width="1"></circle>
			<circle cx="176" cy="100" r="3.4" stroke-width="1"></circle>
			<polyline points="49,45 55,51 49,57" stroke-width="1"></polyline>
			<polyline points="151,143 145,149 151,155" stroke-width="1"></polyline>
			<polyline points="155,49 149,55 155,61" stroke-width="1"></polyline>
			<polyline points="45,139 51,145 45,151" stroke-width="1"></polyline>
		</g>

		<!-- thin coil, counter-turning -->
		<g class="spin2">
			<circle cx="100" cy="100" r="74" fill="none" stroke="#35e57c" stroke-width="4" stroke-dasharray="10 8" opacity="0.3"></circle>
		</g>

		<!-- rune ring -->
		<g class="spin2" filter="url(#rs-spellglow)" fill="none" stroke="#35e57c" opacity="0.7">
			<circle cx="100" cy="100" r="44" stroke-width="0.6" opacity="0.6"></circle>
			<polyline points="141,96 145,100 141,104" stroke-width="1"></polyline>
			<polyline points="59,96 55,100 59,104" stroke-width="1"></polyline>
			<circle cx="100" cy="56" r="2.4" stroke-width="1"></circle>
			<circle cx="100" cy="144" r="2.4" stroke-width="1"></circle>
			<line x1="128" y1="66" x2="134" y2="72" stroke-width="1"></line>
			<line x1="66" y1="128" x2="72" y2="134" stroke-width="1"></line>
			<rect x="128.5" y="128.5" width="5" height="5" stroke-width="1" transform="rotate(45 131 131)"></rect>
			<rect x="66.5" y="66.5" width="5" height="5" stroke-width="1" transform="rotate(45 69 69)"></rect>
		</g>

		<!-- the binding: circle, square, triangle, core -->
		<circle cx="100" cy="100" r="40" fill="url(#rs-corebloom)"></circle>
		<g filter="url(#rs-spellglow)" fill="none" stroke="#35e57c">
			<rect x="83" y="83" width="34" height="34" stroke-width="1" opacity="0.45" transform="rotate(45 100 100)"></rect>
			<polygon points="100,66 130,118 70,118" stroke-width="1.4" opacity="0.85"></polygon>
			<circle cx="100" cy="66" r="3" stroke-width="1" opacity="0.8"></circle>
			<circle cx="130" cy="118" r="3" stroke-width="1" opacity="0.8"></circle>
			<circle cx="70" cy="118" r="3" stroke-width="1" opacity="0.8"></circle>
		</g>
		<circle cx="100" cy="100" r="24" fill="none" stroke="#35e57c" stroke-width="1" opacity="0.5"></circle>
		<circle cx="100" cy="100" r="15" fill="#35e57c" opacity="0.85"></circle>
		<circle cx="100" cy="100" r="7" fill="#eafff2" opacity="0.95"></circle>
	</svg>
</div>
