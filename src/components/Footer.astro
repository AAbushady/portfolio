---
const currentYear = new Date().getFullYear();
---

<footer>
	<p>&copy; {currentYear} alex abushady · exit 0</p>
	<p class="socials">
		<a href="https://github.com/AAbushady">github</a>
		<a href="https://www.linkedin.com/in/alexabushady/">linkedin</a>
		<a href="https://x.com/Epiculous214">x</a>
		<a href="https://huggingface.co/Epiculous">huggingface</a>
	</p>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
		padding: 1.5rem 2rem 2rem;
		border-top: 1px solid var(--hairline);
		text-align: center;
		color: var(--gray-400);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	footer a {
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		color: var(--link-color);
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			justify-content: space-between;
		}

		.socials {
			justify-content: flex-end;
		}
	}
</style>
