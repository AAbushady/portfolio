---
import CallToAction from './CallToAction.astro';
---

<div class="wrapper">
	<aside class="panel">
		<div>
			<h2>Init collaboration?</h2>
			<p class="sub">$ mail -s "let's talk" aabushady214@gmail.com</p>
		</div>
		<CallToAction href="mailto:aabushady214@gmail.com">send message</CallToAction>
	</aside>
</div>

<style>
	.panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		border: 1px solid var(--hairline);
		background: var(--surface);
		padding: 2rem 1.5rem;
	}

	h2 {
		font-family: var(--font-mono);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		letter-spacing: 0.02em;
		color: var(--gray-100);
	}

	.sub {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--gray-400);
		margin-top: 0.5rem;
		overflow-wrap: anywhere;
	}

	@media (min-width: 50em) {
		.panel {
			padding: 3rem 2.5rem;
		}
	}
</style>
