---
// The visitor: a full-screen jump-cut of static, tracking tears, and Alex's
// own headshot infected by the dark place. Fired by scratch-ui.ts (paced by
// nextVisitDelay, or summoned with the S key).
//
// Modeled on AW2's actual smash cuts (studied from capture frames): the image
// takes the whole screen, no framing device, rendered as a monochrome photo
// NEGATIVE — hair, glasses, and eyes glow while the bright wall dies to
// black — smudged, smeared, and veiled in turbulent gray smoke. The jolt
// animation cuts to positive for one frame (see sc-facejolt). All of the
// corruption is render time SVG filter work on the ordinary About-page
// headshot; the repo holds only the normal photo. Each firing is a single
// ~300ms flash so it stays clear of photosensitivity thresholds.
import { getImage } from 'astro:assets';
import headshot from '../../assets/alex-headshot.jpg';

const face = await getImage({ src: headshot, width: 960, format: 'webp' });
---

<div class="sc-visit" id="sc-visit" aria-hidden="true">
	<div class="vnoise"></div>
	<svg class="face" viewBox="0 0 400 480" preserveAspectRatio="xMidYMid slice">
		<defs>
			<!-- main face: vertical motion smudge, gentle warp, desaturate,
			     INVERT, then a hard threshold curve — most tones crush to
			     black, only the top band glows -->
			<filter id="sc-infect" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
				<feGaussianBlur in="SourceGraphic" stdDeviation="0.6 2.2" result="soft" />
				<feTurbulence type="fractalNoise" baseFrequency="0.008 0.03" numOctaves="2" seed="7" result="n" />
				<feDisplacementMap in="soft" in2="n" scale="14" xChannelSelector="R" yChannelSelector="G" result="d" />
				<feColorMatrix in="d" type="saturate" values="0" result="g" />
				<feComponentTransfer in="g" result="neg">
					<feFuncR type="table" tableValues="1 0" />
					<feFuncG type="table" tableValues="1 0" />
					<feFuncB type="table" tableValues="1 0" />
				</feComponentTransfer>
				<feComponentTransfer in="neg">
					<feFuncR type="linear" slope="1.6" intercept="-0.35" />
					<feFuncG type="linear" slope="1.6" intercept="-0.35" />
					<feFuncB type="linear" slope="1.6" intercept="-0.35" />
				</feComponentTransfer>
			</filter>
			<!-- gray afterimage: heavier vertical smear, same negative, dimmer -->
			<filter id="sc-infect-ghost" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
				<feGaussianBlur in="SourceGraphic" stdDeviation="0 4" result="soft" />
				<feTurbulence type="fractalNoise" baseFrequency="0.008 0.026" numOctaves="2" seed="3" result="n" />
				<feDisplacementMap in="soft" in2="n" scale="18" xChannelSelector="R" yChannelSelector="G" result="d" />
				<feColorMatrix in="d" type="saturate" values="0" result="g" />
				<feComponentTransfer in="g" result="neg">
					<feFuncR type="table" tableValues="1 0" />
					<feFuncG type="table" tableValues="1 0" />
					<feFuncB type="table" tableValues="1 0" />
				</feComponentTransfer>
				<feComponentTransfer in="neg">
					<feFuncR type="linear" slope="1.4" intercept="-0.5" />
					<feFuncG type="linear" slope="1.4" intercept="-0.5" />
					<feFuncB type="linear" slope="1.4" intercept="-0.5" />
				</feComponentTransfer>
			</filter>
		</defs>
		<!-- the image sits larger than the viewBox so the slice-fit crop stays
		     tight on the face at any aspect ratio -->
		<g transform="translate(9 -4)" opacity="0.25" style="mix-blend-mode: screen;">
			<image href={face.src} x="-50" y="-30" width="500" height="667" filter="url(#sc-infect-ghost)" />
		</g>
		<image href={face.src} x="-50" y="-30" width="500" height="667" filter="url(#sc-infect)" />
	</svg>
</div>
