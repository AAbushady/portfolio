---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Pill from './Pill.astro';
import { formatDate } from '../utils/format';

interface Props {
	post: CollectionEntry<'blog'>;
	/** Heading level for the post title, matched to the page's outline. */
	headingLevel?: 'h2' | 'h3';
	/** Set 'eager' for cards rendered above the fold (first grid row). */
	loading?: 'eager' | 'lazy';
}

const { data, id } = Astro.props.post;
const Heading = Astro.props.headingLevel ?? 'h3';
const loading = Astro.props.loading ?? 'lazy';
---

<article class="card">
	{data.img && (
		<Image
			src={data.img}
			alt={data.img_alt || `Preview of ${data.title}`}
			widths={[480, 960]}
			sizes="(min-width: 50em) 30vw, 90vw"
			loading={loading}
		/>
	)}
	<div class="content">
		<Heading class="title"><a href={`/blog/${id}/`}>{data.title}</a></Heading>
		<div class="tags">
			{data.tags.map((tag) => (
				<Pill>{tag}</Pill>
			))}
		</div>
		<p class="description">{data.description}</p>
		<div class="meta">
			<time datetime={data.publishDate.toISOString()}>published: {formatDate(data.publishDate)}</time>
			{data.updatedDate && (
				<time datetime={data.updatedDate.toISOString()}>updated: {formatDate(data.updatedDate)}</time>
			)}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--surface);
		border: 1px solid var(--hairline);
		transition: border-color var(--hover-transition);
	}

	/* HUD corner brackets, invisible until hover. */
	.card::before,
	.card::after {
		content: '';
		position: absolute;
		z-index: 1;
		width: 0.875rem;
		height: 0.875rem;
		border: 0 solid transparent;
		transition: border-color var(--hover-transition);
	}

	.card::before {
		top: -1px;
		left: -1px;
		border-top-width: 2px;
		border-left-width: 2px;
	}

	.card::after {
		bottom: -1px;
		right: -1px;
		border-bottom-width: 2px;
		border-right-width: 2px;
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--hairline-strong);
	}

	.card:hover::before,
	.card:hover::after,
	.card:focus-within::before,
	.card:focus-within::after {
		border-color: var(--link-color);
	}

	img {
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		object-fit: cover;
		border-bottom: 1px solid var(--hairline);
	}

	:global(.theme-dark) img {
		filter: saturate(0.9);
		transition: filter var(--hover-transition);
	}

	:global(.theme-dark) .card:hover img {
		filter: saturate(1.05);
	}

	.content {
		padding: 1rem 1.25rem 1.25rem;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.title {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.title a {
		color: var(--gray-100);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.title a:hover {
		color: var(--link-color);
	}

	/* Stretch the title link's hit area over the whole card, keeping the
	   accessible link name short (just the title). */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.description {
		margin: 0;
		color: var(--gray-300);
		font-size: 0.9375rem;
		line-height: 1.5;
		flex-grow: 1;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--gray-400);
	}

	.tags {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
</style>
