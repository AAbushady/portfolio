---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a href={href}><slot /></a>

<style>
	a {
		display: flex;
		place-content: center;
		align-items: center;
		gap: 0.75em;
		padding: 0.9rem 2rem;
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		line-height: 1.1;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		/* link-color flips per theme (deep purple on paper, bright violet on
		   near-black); gray-999 is the matching bg-tone text in both. */
		color: var(--gray-999);
		background: var(--link-color);
		transition:
			transform var(--hover-transition),
			box-shadow var(--hover-transition);
	}

	a:hover,
	a:focus {
		box-shadow: 0 6px 24px var(--accent-overlay);
	}

	@media (prefers-reduced-motion: no-preference) {
		a:hover,
		a:focus {
			transform: translateY(-2px);
		}

		a:active {
			transform: translateY(1px);
			box-shadow: none;
			transition-duration: 0.1s;
		}
	}
</style>
