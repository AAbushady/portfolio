---
import { Image } from 'astro:assets';
import headshot from '../assets/alex-headshot.jpg';
import { getPublishedPosts, getSortedProjects } from '../utils/collections';
import { yearsOfExperience } from '../utils/experience';

// Layout import - provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import Grid from '../components/Grid.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BlogPreview from '../components/BlogPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

// Content Fetching: List four most recent work projects
const projects = (await getSortedProjects()).slice(0, 4);

// Content Fetching: List three most recent blog posts
const blogPosts = (await getPublishedPosts()).slice(0, 3);

// Computed so the experience number never goes stale between deploys.
const years = yearsOfExperience();
---

<BaseLayout>
	<div class="stack gap-20">
		<div class="wrapper stack gap-15">
			<header class="hero">
				<div>
					<div class="prompt-block">
						<p class="prompt" aria-hidden="true">
							<span class="path">~/portfolio</span> $ ./introduce --verbose
						</p>
						<p class="prompt" aria-hidden="true">
							<span class="path">~/portfolio</span> $ <span id="cmd-typed"></span><span class="caret"></span>
						</p>
						<p class="prompt out" id="cmd-out" aria-hidden="true" hidden></p>
						<p class="prompt-hint">hint: try <a href="/ff/">theme ff</a></p>
					</div>
					<h1>Alex<br />Abushady<span class="cursor" aria-hidden="true">_</span></h1>
					<p class="tagline">
						The engineer who delivers. <span class="years-exp">{years}+</span> years shipping
						production systems. Now building games and AI tooling on the same foundation.
					</p>
				</div>
				<div class="frame">
					<span class="corner" aria-hidden="true"></span>
					<Image
						class="headshot"
						src={headshot}
						alt="Alex Abushady smiling in a blue shirt, wearing glasses."
						widths={[480, 640]}
						sizes="(min-width: 50em) 320px, 80vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</header>

			<section class="stack gap-8">
				<h2 class="term-label">
					<span aria-hidden="true"><span class="hash">##</span> capabilities</span>
					<span class="sr-only">Capabilities</span>
				</h2>
				<Skills />
			</section>
		</div>

		<main class="wrapper stack gap-20">
			<section class="stack gap-8">
				<div class="label-row">
					<h2 class="term-label">
						<span aria-hidden="true"><span class="hash">##</span> selected_work</span>
						<span class="sr-only">Selected work</span>
					</h2>
					<a class="view-all" href="/work/">view all -&gt;</a>
				</div>
				<Grid>
					{
						projects.map((project, index) => (
							<li>
								<PortfolioPreview
									project={project}
									index={index}
									loading={index < 2 ? 'eager' : 'lazy'}
								/>
							</li>
						))
					}
				</Grid>
			</section>

			<section class="stack gap-8">
				<div class="label-row">
					<h2 class="term-label">
						<span aria-hidden="true"><span class="hash">##</span> recent_posts</span>
						<span class="sr-only">Recent blog posts</span>
					</h2>
					<a class="view-all" href="/blog/">view all -&gt;</a>
				</div>
				<Grid>
					{
						blogPosts.map((post) => (
							<li>
								<BlogPreview post={post} />
							</li>
						))
					}
				</Grid>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<script>
	// Hero prompt toy: keystrokes anywhere on the page (outside form fields)
	// echo into the live prompt line; Enter runs the command. Purely additive:
	// the visible hint link reaches /ff/ without JS or a keyboard.
	type CommandResult = { output: string } | { href: string };

	function runCommand(input: string): CommandResult {
		const cmd = input.toLowerCase().replace(/\s+/g, ' ');
		if (cmd === 'theme ff') return { href: '/ff/' };
		if (cmd === 'theme dark' || cmd === 'theme light')
			return { output: "light/dark lives in the nav toggle. try: theme ff" };
		if (cmd === 'theme' || cmd === 'theme --list') return { output: 'available themes: ff' };
		if (cmd === 'help') return { output: "commands: theme ff, help, clear" };
		if (cmd === 'clear') return { output: '' };
		if (cmd.startsWith('sudo')) return { output: 'nice try.' };
		return { output: `${cmd.split(' ')[0]}: command not found (try 'help')` };
	}

	const typed = document.getElementById('cmd-typed');
	const out = document.getElementById('cmd-out');
	let buffer = '';

	const render = () => {
		if (typed) typed.textContent = buffer;
	};

	const print = (text: string) => {
		if (!out) return;
		out.textContent = text;
		out.hidden = text === '';
	};

	const submit = () => {
		const input = buffer.trim();
		buffer = '';
		render();
		if (!input) return;
		const result = runCommand(input);
		if ('href' in result) {
			window.location.href = result.href;
			return;
		}
		print(result.output);
	};

	const isTypingTarget = (el: EventTarget | null) =>
		el instanceof HTMLElement &&
		(el.tagName === 'INPUT' ||
			el.tagName === 'TEXTAREA' ||
			el.tagName === 'SELECT' ||
			el.isContentEditable);

	document.addEventListener('keydown', (e) => {
		if (!typed || e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
		if (isTypingTarget(e.target)) return;
		// Leave focused links/buttons alone so keyboard activation still works.
		if (e.target instanceof HTMLAnchorElement || e.target instanceof HTMLButtonElement) return;
		if (e.key === 'Enter') {
			submit();
		} else if (e.key === 'Escape') {
			buffer = '';
			render();
			print('');
		} else if (e.key === 'Backspace') {
			buffer = buffer.slice(0, -1);
			render();
		} else if (e.key.length === 1 && buffer.length < 40) {
			// Mid-command spaces must not scroll the page.
			if (e.key === ' ' && buffer.length > 0) e.preventDefault();
			buffer += e.key;
			render();
		}
	});
</script>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding-top: 1.5rem;
	}

	.prompt-block {
		margin-bottom: 1.5rem;
	}

	.prompt {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--gray-400);
	}

	.prompt + .prompt,
	.prompt.out {
		margin-top: 0.35rem;
	}

	.prompt.out {
		color: var(--gray-300);
	}

	.prompt-hint {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--gray-400);
		margin-top: 0.5rem;
	}

	.prompt .path {
		color: var(--link-color);
	}

	.caret {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		background: var(--link-color);
		vertical-align: text-bottom;
		margin-left: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.caret {
			animation: blink 1.1s steps(1) infinite;
		}

		@keyframes blink {
			50% {
				opacity: 0;
			}
		}
	}

	.hero h1 {
		font-family: var(--font-mono);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(2.25rem, 5.5vw, 4rem);
		line-height: 1.05;
		letter-spacing: 0.01em;
		color: var(--gray-0);
	}

	.hero h1 .cursor {
		color: var(--link-color);
	}

	.tagline {
		margin-top: 1.5rem;
		font-size: var(--text-lg);
		max-width: 36rem;
	}

	.frame {
		position: relative;
		align-self: center;
		padding: 0.75rem;
	}

	.frame::before,
	.frame::after,
	.frame .corner::before,
	.frame .corner::after {
		content: '';
		position: absolute;
		width: 1.25rem;
		height: 1.25rem;
		border: 0 solid var(--link-color);
	}

	.frame::before {
		top: 0;
		left: 0;
		border-top-width: 2px;
		border-left-width: 2px;
	}

	.frame::after {
		top: 0;
		right: 0;
		border-top-width: 2px;
		border-right-width: 2px;
	}

	.frame .corner::before {
		bottom: 0;
		left: 0;
		border-bottom-width: 2px;
		border-left-width: 2px;
	}

	.frame .corner::after {
		bottom: 0;
		right: 0;
		border-bottom-width: 2px;
		border-right-width: 2px;
	}

	.headshot {
		display: block;
		width: 100%;
		max-width: 20rem;
		aspect-ratio: 4 / 5;
		height: auto;
		object-fit: cover;
		object-position: top;
	}

	:global(.theme-dark) .headshot {
		filter: saturate(0.85) contrast(1.05);
	}

	.label-row {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}

	.label-row .term-label {
		flex: 1;
	}

	.view-all {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.view-all:hover,
	.view-all:focus {
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 5fr 3fr;
			align-items: center;
			gap: 3rem;
			padding-top: 2.5rem;
		}

		.frame {
			justify-self: center;
		}
	}
</style>
