---
import { type CollectionEntry, render } from 'astro:content';

import ScratchEntryLayout from '../../../layouts/ScratchEntryLayout.astro';
import { getPublishedPosts } from '../../../utils/collections';
import { substituteYears } from '../../../utils/experience';
import { formatDateISO } from '../../../utils/format';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const blog = await getPublishedPosts();
	return blog.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const description = substituteYears(entry.data.description);
const descriptionHtml = substituteYears(entry.data.description, { html: true });
const imgAlt = entry.data.img_alt || `${entry.data.title} blog preview`;
---

<ScratchEntryLayout
	title={entry.data.title}
	description={description}
	descriptionHtml={descriptionHtml}
	tags={entry.data.tags}
	img={entry.data.img}
	imgAlt={entry.data.img ? imgAlt : undefined}
	backHref="/scratch/blog/"
	backLabel="Loose pages"
	exitHref={`/blog/${entry.id}/`}
	navCurrent="log"
	ogImage={entry.data.img?.src}
	ogImageAlt={entry.data.img ? imgAlt : undefined}
	publishDate={entry.data.publishDate}
>
	<span slot="meta">found: {formatDateISO(entry.data.publishDate)}</span>
	{entry.data.updatedDate && (
		<span slot="meta">rewritten: {formatDateISO(entry.data.updatedDate)}</span>
	)}
	<Content />
</ScratchEntryLayout>
