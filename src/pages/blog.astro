---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

import BlogPreview from '../components/BlogPreview.astro';
import { getPublishedPosts } from '../utils/collections';

const blogPosts = await getPublishedPosts();

// Blog images are optional, and text-only cards are short, so the first
// image-bearing cards can sit above the fold regardless of their list index.
// Eager-load the first two images rather than the first two cards.
const eagerIds = new Set(
	blogPosts
		.filter((post) => post.data.img)
		.slice(0, 2)
		.map((post) => post.id)
);
---

<BaseLayout
	title="Blog | Alex Abushady"
	description="Follow Alex's development journey and project insights"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Development Blog"
				tagline="Follow my development journey, project updates, and technical insights."
				align="start"
			/>
			<Grid>
				{
					blogPosts.map((post) => (
						<li>
							<BlogPreview
								post={post}
								headingLevel="h2"
								loading={eagerIds.has(post.id) ? 'eager' : 'lazy'}
							/>
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>